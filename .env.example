# Copy to .env and fill in (scripts/install.sh does the copy). Never commit .env.
# The harness reads it on every start; variables already set in the environment win.

# Claude API (https://platform.claude.com). Leave empty to use HARNESS_PROVIDER=scripted for an offline demo.
ANTHROPIC_API_KEY=

# Optional overrides. The Docker image already points the writable paths at /app/data.
# HARNESS_PROVIDER=anthropic
# HARNESS_MODEL=claude-opus-5-5
# HARNESS_DAILY_BUDGET_USD=10
# HARNESS_RUN_BUDGET_USD=2
# HARNESS_CONFIG=config/harness.yaml
# HARNESS_DATA_DIR=./data
# HARNESS_WORKSPACE_DIR=./data/workspace
# HARNESS_KNOWLEDGE_DIR=./knowledge
# HARNESS_SCRAPERS_DIR=./config/scrapers
# HARNESS_SKILLS_DIR=./skills
# HARNESS_LEARNED_SKILLS_DIR=./skills
# HARNESS_AGENTS_DIR=./agents
# HARNESS_DASHBOARDS_DIR=./data/dashboards
# This deployment's column in config/domains.yaml (docs/domains.md), such as server or claude-code-cloud
# HARNESS_ENVIRONMENT=server
# LOG_LEVEL=info
# LOG_FORMAT=json
# Web port for /healthz and /dashboards/ (keep 8080 for Docker: the compose file maps it).
# PORT=8080
# Interface for a local install: 127.0.0.1 (the default) keeps the dashboards on this machine,
# 0.0.0.0 opens them to your network (set DASHBOARD_PASSWORD). Leave it unset for Docker.
# HOST=127.0.0.1

# Discord bot (optional). Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Guild id makes slash commands appear instantly in that server (global commands can take up to an hour).
DISCORD_GUILD_ID=
DISCORD_REPORTS_CHANNEL_ID=
DISCORD_ALERTS_CHANNEL_ID=
# Comma-separated ids. The bot refuses everyone who is not listed (it can run code on your server).
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ADMIN_USER_IDS=
# DISCORD_ALLOW_EVERYONE=false

# Webhook-only notifications (no bot needed): Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_REPORTS_URL=
DISCORD_WEBHOOK_ALERTS_URL=

# Dashboards, served under /dashboards/ on PORT. The compose file binds the port to the host's
# loopback; reach it with an SSH tunnel or a private network, or put a TLS proxy in front and set
# a password (docs/dashboards.md).
DASHBOARD_PASSWORD=
# DASHBOARD_USER=harness
# Base URL for links in Discord and tool results, such as https://harness.example.com
DASHBOARD_PUBLIC_URL=
